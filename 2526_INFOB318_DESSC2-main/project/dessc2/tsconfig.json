{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,        
    "jsx": "react-jsx",      
    "types": ["jest", "node"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",        
    "rootDir": "src"         
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}